# Backend env — copy to Pravi/.env (never commit the real file)

# Supabase (Project Settings → API Keys)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Supabase → Connect → "Session pooler" string, with your DB password filled in
DATABASE_URL=

# Cloudinary (only if file uploads use Cloudinary — decided at M3)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# App
PORT=4000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=

# Optional — M13 inbound grievance adapters (CPGRAMS / SWAGAT). Any long random string; share it only with the portal.
# Leave empty to keep inbound integrations disabled (they answer 503).
INTEGRATION_API_KEY=
# Optional — set to true to stop the in-process daily jobs (e.g. when a platform cron calls POST /admin/jobs/daily/run)
DISABLE_SCHEDULER=

# Optional — only when Redis is running (docker compose up redis)
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------
# Frontend env — put these in frontend/.env.local (public values only,
# NEVER the secret key)
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
